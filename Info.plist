<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.lumind.tvremote</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lumindtv</string>
			</array>
		</dict>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_androidtvremote2._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>TVRemote needs local network access to find your TV and send it commands.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<!-- The Live Activity gives us a Lock Screen UI but no background execution.
	     Silent audio under this mode is what keeps the TLS session to the TV open
	     between presses; see AudioKeepAlive. It only runs while a session is up. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
